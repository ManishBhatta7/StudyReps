# StudyReps Content Pipeline - Environment Variables
# Copy this to .env and fill in your API keys

# === REQUIRED ===

# Google Gemini API Key (for script generation)
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key_here

# Supabase (for video storage)
# Get from: Supabase Dashboard → Settings → API
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_KEY=your_service_role_key

# === OPTIONAL (for better audio quality) ===

# Google Cloud Text-to-Speech
# Get from: https://console.cloud.google.com/apis/credentials
# Note: Requires billing enabled
GOOGLE_TTS_API_KEY=your_google_tts_key

# OR ElevenLabs (recommended for natural voices)
# Get from: https://elevenlabs.io/api
ELEVENLABS_API_KEY=your_elevenlabs_key

# === DEFAULTS (can customize) ===

# Default TTS provider: 'google' or 'elevenlabs'
TTS_PROVIDER=google

# Video settings
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_BACKGROUND_COLOR=#0F172A
VIDEO_ACCENT_COLOR=#6366F1
